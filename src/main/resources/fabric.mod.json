{
  "schemaVersion": 1,
  "id": "native",
  "version": "${version}",
  "name": "Native Client",
  "description": "Connects Minecraft to your Native account and shows every Native player's skin and cape, live. Works on Minecraft 1.16 through 26.3.",
  "authors": [
    "Native Team"
  ],
  "contact": {
    "homepage": "https://playnative.fun",
    "sources": "https://github.com/atlas-thedev/native-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/native/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "xyz.nativelaunch.NativeMod"
    ],
    "modmenu": [
      "io.github.adytech99.healthindicators.config.ModMenuAPIImpl"
    ]
  },
  "accessWidener": "healthindicators.accesswidener",
  "mixins": [
    "native.mixins.json",
    "healthindicators.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.0"
  },
  "suggests": {
    "fabric": "*",
    "yet_another_config_lib_v3": "*"
  }
}
