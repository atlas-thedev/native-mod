{
  "schemaVersion": 1,
  "id": "noctra",
  "version": "${version}",
  "name": "Noctra Client",
  "description": "Connects Minecraft to your Noctra account and shows every Noctra player's skin and cape, live. Works on Minecraft 1.16 through 26.3.",
  "authors": [
    "Noctra Team"
  ],
  "contact": {
    "homepage": "https://nativelaunch.xyz",
    "sources": "https://github.com/atlas-thedev/noctra-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/noctra/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "dev.noctra.NoctraPreLaunch"
    ],
    "client": [
      "dev.noctra.NoctraMod"
    ]
  },
  "mixins": [
    "noctra.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.0"
  }
}
